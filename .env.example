# ============================================================
# ABACUSUP — Environment Configuration Template
# Phase 1 Foundation & Core Education Management System
# ============================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Session & Security Secret
AUTH_SECRET="your-super-secret-auth-key-change-in-production-min-32-chars"

# Storage Credentials (Phase 2 Cloud Provider: S3 / Cloudflare R2 / AWS)
STORAGE_PROVIDER="local" # "local" | "s3" | "r2"
STORAGE_BUCKET="abacusup-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your_storage_access_key"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_key"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"

# Email Provider Credentials (Phase 2 In-App / SMTP Provider: SendGrid / Resend)
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="notifications@abacusup.com"

# SMS Service Credentials (Phase 2 Twilio / AWS SNS)
SMS_PROVIDER="twilio"
SMS_ACCOUNT_SID="your_sms_account_sid"
SMS_AUTH_TOKEN="your_sms_auth_token"
SMS_FROM_NUMBER="+18005550199"

# ============================================================
# Payment Gateway Secrets (Phase 3) — NEVER hard-code in source
# ============================================================
# Stripe (International)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
# bKash (Bangladesh)
BKASH_MERCHANT_ID="your_bkash_merchant_id"
BKASH_SECRET_KEY="your_bkash_secret_key"
# Nagad (Bangladesh)
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_SECRET_KEY="your_nagad_secret_key"
# SSLCommerz (Bangladesh)
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcommerz_store_password"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Email / SMS Providers (Phase 4) — provider is swappable
# ============================================================
EMAIL_PROVIDER="console"   # console | smtp | resend | sendgrid
RESEND_API_KEY="re_your_resend_key"
SENDGRID_API_KEY="SG.your_sendgrid_key"
# SMS_PROVIDER: console | twilio | bulksmsbd | ssl_wireless | greenweb (Bangladesh)
SMS_SENDER_ID="ABACUSUP"
BULKSMSBD_API_KEY="your_bulksmsbd_key"
SSL_SMS_API_TOKEN="your_ssl_wireless_token"
GREENWEB_TOKEN="your_greenweb_token"
